[
  {
    "name": "get_playbook",
    "description": "Get a playbook (ordered prompt workflow) with fully hydrated steps, by id or exact title.",
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "id_or_title": {
          "type": "string"
        }
      },
      "required": [
        "id_or_title"
      ]
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "PromptDetailOut": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "title": { "type": "string" },
            "description": { "type": ["string", "null"] },
            "tags": {
              "type": "array",
              "items": { "type": "string" }
            },
            "is_favorite": { "type": "boolean" },
            "is_pinned": { "type": "boolean" },
            "created_at": { "type": ["string", "null"] },
            "updated_at": { "type": ["string", "null"] },
            "primary_variant_id": { "type": ["string", "null"] },
            "variants": {
              "type": "array",
              "items": { "$ref": "#/$defs/VariantOut" }
            }
          },
          "required": [
            "id",
            "title",
            "tags",
            "is_favorite",
            "is_pinned",
            "variants"
          ]
        },
        "StepOut": {
          "type": "object",
          "properties": {
            "position": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "step_type": { "type": "string" },
            "instructions": { "type": ["string", "null"] },
            "prompt": {
              "anyOf": [
                { "$ref": "#/$defs/PromptDetailOut" },
                { "type": "null" }
              ]
            },
            "choice_prompts": {
              "type": "array",
              "items": { "$ref": "#/$defs/PromptDetailOut" }
            },
            "missing": { "type": "boolean" }
          },
          "required": [
            "position",
            "step_type",
            "choice_prompts",
            "missing"
          ]
        },
        "VariantOut": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "label": { "type": ["string", "null"] },
            "content": { "type": "string" },
            "is_primary": { "type": "boolean" }
          },
          "required": [
            "id",
            "content",
            "is_primary"
          ]
        }
      },
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/StepOut" }
        }
      },
      "required": [
        "id",
        "title",
        "steps"
      ]
    }
  },
