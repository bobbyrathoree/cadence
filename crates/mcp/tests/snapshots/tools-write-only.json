        "variant_id": { "type": ["string", "null"] },
        "content": { "type": "string" }
      },
      "required": [
        "prompt_id",
        "content"
      ]
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "VariantOut": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "label": { "type": ["string", "null"] },
            "content": { "type": "string" },
            "is_primary": { "type": "boolean" }
          },
          "required": [
            "id",
            "content",
            "is_primary"
          ]
        }
      },
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "is_favorite": { "type": "boolean" },
        "is_pinned": { "type": "boolean" },
        "created_at": { "type": ["string", "null"] },
        "updated_at": { "type": ["string", "null"] },
        "primary_variant_id": { "type": ["string", "null"] },
        "variants": {
          "type": "array",
          "items": { "$ref": "#/$defs/VariantOut" }
        }
      },
      "required": [
